<Ui xmlns="http://www.blizzard.com/wow/ui/">
  <Button name="EventQEventRowTemplate" virtual="true" inherits="BackdropTemplate">
    <Size x="340" y="40"/>
    <HighlightTexture file="Interface/QuestFrame/UI-QuestTitleHighlight" alphaMode="ADD"/>
  </Button>

  <Button name="EventQSeriesOccurrenceRowTemplate" virtual="true" inherits="BackdropTemplate">
    <Size x="340" y="28"/>
    <HighlightTexture file="Interface/QuestFrame/UI-QuestTitleHighlight" alphaMode="ADD"/>
  </Button>

  <!-- Settings panel element used to draw a subtle horizontal divider line. -->
  <Frame name="EventQSettingsDividerTemplate" virtual="true">
    <Size y="4"/>
    <Layers>
      <Layer level="BACKGROUND">
        <Texture parentKey="Line" file="Interface/Buttons/WHITE8X8">
          <Anchors>
            <Anchor point="LEFT" x="7" y="0"/>
            <Anchor point="RIGHT" x="-7" y="0"/>
          </Anchors>
          <Size y="1"/>
          <Color a="0.35" r="1" g="1" b="1"/>
        </Texture>
      </Layer>
    </Layers>
  </Frame>
</Ui>
